{
  "productName": "SayForge",
  "version": "0.2.5",
  "identifier": "com.oriapps.sayforge",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "SayForge",
        "width": 1120,
        "height": 768,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": false,
        "dragDropEnabled": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' blob: data:",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "style-src-attr": "'unsafe-inline'",
        "font-src": "'self' https://fonts.gstatic.com",
        "img-src": "'self' blob: data:",
        "media-src": "'self' blob: data:",
        "worker-src": "'self' blob: data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' blob: data:",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "style-src-attr": "'unsafe-inline'",
        "font-src": "'self' https://fonts.gstatic.com",
        "img-src": "'self' blob: data:",
        "media-src": "'self' blob: data:",
        "worker-src": "'self' blob: data:",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:1420 ws://127.0.0.1:1420 ws://localhost:1421 ws://127.0.0.1:1421",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "resources/*": "resources/"
    },
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "shortDescription": "Voice typing and optional AI cleanup",
    "longDescription": "SayForge by OriApps: open-source voice typing for Windows, distributed under AGPL-3.0.",
    "copyright": "© 2026 OriApps; portions © 2026 Liu Qianglong and contributors",
    "category": "Productivity",
    "windows": {
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": false,
        "languages": [
          "English"
        ],
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY3QzcxNDk3Q0JFMzY4QzgKUldUSWFPUExseFRIWjFpaUZqenVDQkR0L1JYcWxIQld4SGc0c2hsUzVSWVJvRXBMRVFkNzMyYVoK",
      "endpoints": ["https://github.com/Akilaydin/OriApps.SayForge/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
