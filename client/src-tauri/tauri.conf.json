{
  "productName": "SayForge",
  "version": "0.2.2",
  "identifier": "com.oriapps.sayforge",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "SayForge",
        "width": 1120,
        "height": 768,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": false,
        "dragDropEnabled": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "resources": {
      "resources/*": "resources/",
      "transcribe-libs/*": "./"
    },
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "shortDescription": "Voice typing and optional AI cleanup",
    "longDescription": "SayForge by OriApps: open-source voice typing for Windows. Based on SayIt (AGPL-3.0).",
    "copyright": "© 2026 OriApps; based on SayIt © 2026 Liu Qianglong & contributors",
    "category": "Productivity",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "English"
        ],
        "installerIcon": "icons/icon.ico"
      },
      "wix": {
        "language": [
          "en-US"
        ]
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
